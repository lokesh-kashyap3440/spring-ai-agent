# =============================================================================
# Spring AI Agent - Environment Configuration (Template)
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
#
# Docker Compose loads .env automatically. For native runs, Spring Boot also
# loads .env from the working directory.
# =============================================================================

# ---- Server ----
SERVER_PORT=8082

# ---- Active Spring Profile ----
ACTIVE_PROFILES=default

# ---- PostgreSQL / Datasource ----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aiagent
SPRING_DATASOURCE_USERNAME=aiagent
SPRING_DATASOURCE_PASSWORD=change-me
DATASOURCE_POOL_SIZE=10

# ---- Ollama (Chat + Embeddings) ----
# When running inside Docker, use: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_CONSUMER_GROUP_ID=ai-agent-group
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
KAFKA_CONSUMER_CONCURRENCY=3
KAFKA_CONSUMER_MAX_POLL_RECORDS=500

# ---- AI Provider ----
AI_PROVIDER=ollama

# ---- NVIDIA (Chat) ----
# Required: set your NVIDIA API key
# Get one at: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=stepfun-ai/step-3.5-flash
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT=60
NVIDIA_MAX_TOKENS=16000
NVIDIA_TEMPERATURE=0.4

# ---- Ollama (Chat) ----
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=180
OLLAMA_MAX_TOKENS=2048
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_TEMPERATURE=0.4

# ---- Agent Behaviour ----
AGENT_MAX_ITERATIONS=6
AGENT_MEMORY_SIZE=20
AGENT_VERBOSE=false

# ---- Kafka Topics ----
KAFKA_TOPIC_EVENTS=ai-agent-events
KAFKA_TOPIC_CHAT=ai-agent-chat

# ---- MCP Server ----
MCP_SERVER_NAME=ai-agent-tools
MCP_SERVER_VERSION=1.0.0

# ---- JWT Authentication ----
# Change this to a random 64-character hex string in production
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-hex-string-in-production
JWT_EXPIRATION_MS=86400000

# ---- Logging ----
LOG_LEVEL=INFO
KAFKA_LOG_LEVEL=WARN
AI_LOG_LEVEL=WARN
